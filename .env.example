# Your email address — required by Unpaywall API (no registration needed)
UNPAYWALL_EMAIL=your@email.com

# NCBI API key — optional but increases rate limit from 3 to 10 req/s
# Get one free at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# How many days back to harvest (default: 30)
HARVEST_DAYS=30

# Max papers to process per run (0 = unlimited)
MAX_PAPERS=500
