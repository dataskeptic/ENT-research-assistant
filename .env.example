# ——————————————————————————————————————————————————————————
# Harvest / PubMed settings
# ——————————————————————————————————————————————————————————

# Your email address — required by Unpaywall API (no registration needed)
UNPAYWALL_EMAIL=your@email.com

# NCBI API key — optional but raises rate limit from 3 to 10 req/s
# Get one free at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# How many days back to harvest (default: 30)
HARVEST_DAYS=30

# Max papers to process per run (0 = unlimited)
MAX_PAPERS=500


# ——————————————————————————————————————————————————————————
# RAG / OpenRouter settings
# ——————————————————————————————————————————————————————————

# Required: get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: shown in OpenRouter dashboard under your requests
APP_URL=http://localhost
APP_TITLE=ETN Research Assistant

# —— Model overrides (defaults are set in rag/config.py) ——
# LLM for answer synthesis
RAG_LLM_MODEL=nvidia/nemotron-ultra-253b-v1:free

# Embedding model (must support OpenRouter /embeddings)
RAG_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Generation settings
RAG_LLM_MAX_TOKENS=2048
RAG_LLM_TEMPERATURE=0.1

# Retrieval settings
RAG_TOP_K=8
RAG_COLLECTION=etn_papers

# Chunking settings
RAG_CHUNK_MAX_TOKENS=512
RAG_CHUNK_OVERLAP=64
